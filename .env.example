# Copy to .env and fill in. Never commit .env.

# LaunchDarkly (project: launchpad-wealth) — used from Friday
LD_CLIENT_SIDE_ID=
LD_SDK_KEY=

# Databricks warehouse-native metrics — used Sat/Sun
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_WAREHOUSE_ID=
DATABRICKS_ENABLED=false

# Optional: path to an alternate brand file (relative to repo root).
# Default is ./brand.json. Example: BRAND_FILE=brands/kestrel.json
BRAND_FILE=

# Optional: stub backend port (client dev server proxies /api here). Default 4100.
SERVER_PORT=
